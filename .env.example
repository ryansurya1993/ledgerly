# Copy this file to .env (gitignored, never committed) and change the
# values to override the throwaway local-dev defaults baked into
# docker-compose.yml. Not required just to run `docker-compose up` --
# the defaults already work out of the box for local dev.
#
# These are never used in production -- see each service's README for
# how real credentials are provisioned there (a Kubernetes Secret).

LEDGER_DB_NAME=ledgerly
LEDGER_APP_DB_USER=ledger_app
LEDGER_APP_DB_PASSWORD=devsecret_app
LEDGER_MIGRATE_DB_USER=postgres
LEDGER_MIGRATE_DB_PASSWORD=devsecret_migrate
RABBITMQ_USER=ledgerly
RABBITMQ_PASSWORD=devsecret_rabbitmq
